@implements IAsyncDisposable
@inject IJSRuntime JS
@inject GameClient Client
@inject NavigationManager Navigation

<div class="game-shell @(Client.View is null ? "menu-state" : "battle-state")">
    <div class="world" @ref="world" aria-label="@T("Arena tiga dimensi", "Three-dimensional arena")"></div>
    <div class="vignette"></div>
    <header class="masthead">
        <button class="brand" @onclick="Home" aria-label="@T("Menu utama", "Main menu")"><span class="brand-mark">✧</span><span>BATTLE OF<br /><strong>NUSANTARA</strong></span></button>
        @if (Client.View is null)
        {
            <nav aria-label="Main navigation">
                <button class="@(page == "home" ? "active" : "")" @onclick='() => page = "home"'>@T("BERANDA", "HOME")</button>
                <button class="@(page == "heroes" ? "active" : "")" @onclick='() => page = "heroes"'>@T("PAHLAWAN", "HEROES")</button>
                <button class="@(page == "story" ? "active" : "")" @onclick='() => page = "story"'>@T("KRONIK", "CHRONICLE")</button>
            </nav>
        }
        else
        {
            <span class="match-label">@Client.View.Mode.ToString().ToUpperInvariant() <span>•</span> @TimeLabel @if (Client.RoomCode is not null) { <b>ROOM @Client.RoomCode</b> } @if (Client.Spectating) { <b class="spectator-tag">@T("PENONTON", "SPECTATOR")</b> } <em class="sky-chip" data-weather="@CurrentSky.Weather" data-phase="@CurrentSky.Phase" title="@T("Kabut dan badai memperpendek jarak pandang semua unit. Waktu hari hanya tampilan.", "Mist and storm shorten every unit's sight. The time of day is visual only.")">@SkyLabel</em></span>
        }
        <button class="quiet-button" @onclick='() => OpenPanel("options")'>⚙ <span>@T("Pengaturan", "Settings")</span></button>
    </header>

    @if (Client.View is { } state)
    {
        <div class="battle-top">
            <div class="objective"><span class="eyebrow">@T("MISI AKTIF", "ACTIVE MISSION")</span><h2>@(state.Mode == GameMode.Adventure ? T("Pulihkan tiga prasasti", "Recover three inscriptions") : T("Pertahankan Jagat Nusantara", "Defend Jagat Nusantara"))</h2><p>@(state.Mode == GameMode.Adventure ? T("Kumpulkan prasasti, lalu kalahkan Sang Kalatidha.", "Collect inscriptions, then defeat Sang Kalatidha.") : (state.Mode == GameMode.Moba ? T("Runtuhkan satu menara untuk membuka gerbang musuh. Pulihkan HP di candi sendiri.", "Topple a tower to expose the enemy gate. Heal beside your shrine.") : T("Hancurkan gerbang musuh. Pulihkan HP di candi sendiri.", "Destroy the enemy gate. Heal beside your shrine.")))</p></div>
            <div class="resources"><span>◈ <b>@state.Gold</b> @T("Emas", "Gold")</span>@if (state.Mode == GameMode.Rts) { <span>⚑ <b>@state.Supplies</b> @T("Suplai", "Supply")</span> } @if (state.Mode == GameMode.Adventure) { <span>✧ <b>@state.Relics / 3</b> @T("Prasasti", "Inscriptions")</span> } @if (state.Mode == GameMode.Moba) { <span class="tower-count">♜ <b>@state.Units.Count(u => u.Kind == "tower" && u.Team == 0) – @state.Units.Count(u => u.Kind == "tower" && u.Team == 1)</b> @T("Menara", "Towers")</span> @if (state.Buff > 0) { <span class="blessing">✦ @T("Restu", "Blessing") <b>@Math.Ceiling(state.Buff)s</b></span> } @if (state.EnemyBuff > 0) { <span class="enemy-blessing">✦ @T("Restu musuh", "Enemy blessing") <b>@Math.Ceiling(state.EnemyBuff)s</b></span> } }<span>◇ @T("Level", "Level") @state.Level</span></div>
        </div>
        <div class="battle-help">@(Client.Spectating ? T("Mode penonton: kamu melihat apa yang dilihat tim dan tidak dapat memberi perintah.", "Spectator mode: you see what the team sees and cannot give orders.") : T("Klik arena untuk bergerak • Serang otomatis • Q Ultimate • W Tameng • Esc Jeda", "Click arena to move • Auto attack • Q Ultimate • W Guard • Esc Pause"))</div>
        @if (state.Quests is { } quests)
        {
            <aside class="quest-log" aria-label="@T("Catatan misi", "Quest log")">
                <span class="eyebrow">@T("CATATAN MISI", "QUEST LOG")</span>
                <ol>
                    @foreach (var quest in quests)
                    {
                        var definition = Story.Quest(quest.Id);
                        var side = Story.SideQuests.Any(q => q.Id == quest.Id);
                        <li data-quest="@quest.Id" data-state="@quest.State" class="@(side ? "side-quest" : "")"><span>@(quest.State == QuestState.Done ? "✓" : quest.State == QuestState.Active ? "◇" : "·")</span><span>@T(definition.Title, definition.TitleEn)@(quest.Goal > 1 ? $" · {quest.Progress}/{quest.Goal}" : "")</span></li>
                    }
                </ol>
            </aside>
        }
        @if (Line is { } line)
        {
            <section class="dialogue" aria-live="polite" aria-label="@T("Dialog", "Dialogue")">
                <span class="eyebrow">@line.Speaker</span>
                <p>@T(line.Text, line.TextEn)</p>
                <button @onclick="() => Issue(new GameCommand(CommandKind.AdvanceDialogue))">@T("Lanjut", "Next") ▸</button>
            </section>
        }
        @if (Line is null && NearbyNpc is { } npc)
        {
            <section class="npc-ask" data-npc="@npc.Id" aria-live="polite" aria-label="@T("Tanya", "Ask") @npc.Name">
                <span class="eyebrow">@npc.Name @if (npcAnswer is not null && !npcBusy) { <em class="npc-source" data-source="@npcAnswer.Source">@(npcAnswer.Source == "llm" ? T("jawaban AI", "AI reply") : T("naskah", "scripted"))</em> }</span>
                <p>@(npcBusy ? T($"{npc.Name} merenung…", $"{npc.Name} ponders…") : npcAnswer?.Text ?? T("Apa yang ingin kau ketahui, pengembara?", "What would you know, traveller?"))</p>
                <div class="npc-topics">@foreach (var topic in Story.TopicsOf(npc.Id)) { <button disabled="@npcBusy" data-topic="@topic.Id" @onclick="() => AskNpc(topic.Id)">@T(topic.Question, topic.QuestionEn)</button> }</div>
                <form class="npc-talk" @onsubmit="TalkToNpc" @onsubmit:preventDefault><input id="npc-question" maxlength="@GameClient.MaxNpcQuestion" placeholder="@T("Tulis pertanyaanmu sendiri…", "Type your own question…")" aria-label="@T("Pertanyaan", "Question")" @bind="npcQuestion" @bind:event="oninput" disabled="@npcBusy" /><button type="submit" disabled="@(npcBusy || string.IsNullOrWhiteSpace(npcQuestion))">@T("Tanya", "Ask")</button></form>
            </section>
        }
        @if (state.Mode == GameMode.Rts && !Client.Spectating)
        {
            <aside class="tactical-panel" aria-label="@T("Komando pasukan", "Squad command")">
                <span class="eyebrow">@T("KOMANDO PASUKAN", "SQUAD COMMAND")</span>
                <div class="selection-summary"><strong>@selection.Count</strong> @T("unit dipilih", "units selected") <small>@OrderLabel</small></div>
                <div class="tactical-actions">
                    <button @onclick="SelectHero" disabled="@(Player is null)"><kbd>1</kbd>@T("Pilih hero", "Select hero")</button>
                    <button @onclick="SelectArmy" disabled="@(!OwnSoldiers.Any())"><kbd>2</kbd>@T("Pilih pasukan", "Select army")</button>
                    <button @onclick="ToggleAttackMove" aria-pressed="@(attackMove ? "true" : "false")" disabled="@(selection.Count == 0)"><kbd>A</kbd>@T("Serang-bergerak", "Attack-move")</button>
                    <button @onclick="HoldPosition" disabled="@(selection.Count == 0)"><kbd>H</kbd>@T("Tahan posisi", "Hold position")</button>
                </div>
                <div class="unit-roster" aria-label="@T("Unit milikmu", "Your units")">
                    @foreach (var unit in state.Units.Where(u => u.Owner == Client.Owner && (u.Kind is "hero" or "soldier" or "worker")))
                    {
                        <button class="@(selection.Contains(unit.Id) ? "selected" : "")" aria-pressed="@(selection.Contains(unit.Id) ? "true" : "false")" @onclick="() => SelectUnit(unit.Id, true)">@UnitLabel(unit.Kind) @unit.Id @(unit.Cargo > 0 ? $"· {unit.Cargo} ◈" : "")</button>
                    }
                </div>
                <div class="control-groups" aria-label="@T("Grup kontrol", "Control groups")">
                    @for (var slot = 4; slot <= 6; slot++)
                    {
                        var groupSlot = slot;
                        <div><button data-group="@groupSlot" disabled="@(groups.Count(groupSlot) == 0)" aria-label="@T("Panggil grup", "Recall group") @groupSlot" @onclick="() => ControlGroup(groupSlot, false)"><kbd>@groupSlot</kbd><span>@groups.Count(groupSlot)</span></button>
                        <button disabled="@(selection.Count == 0)" title="Ctrl+@groupSlot / Alt+@groupSlot" aria-label="@T("Simpan grup", "Save group") @groupSlot" @onclick="() => ControlGroup(groupSlot, true)">+</button></div>
                    }
                </div>
                <svg class="tactical-map" data-tactical-map="true" viewBox="0 0 100 100" role="img" aria-label="@T("Peta taktis; klik untuk memberi tujuan", "Tactical map; click to issue a destination")">
                    <path d="M13 13L87 87 M13 13L18 87L87 87 M13 13L87 18L87 87" class="map-lanes" />
                    @foreach (var obstacle in state.Obstacles) { <rect x="@(obstacle.X - obstacle.Width / 2)" y="@(obstacle.Z - obstacle.Depth / 2)" width="@obstacle.Width" height="@obstacle.Depth" class="map-obstacle" /> }
                    @if (state.Vision.Length > 0)
                    {
                        <mask id="fog-mask"><rect width="100" height="100" fill="#fff" />@foreach (var source in state.Vision) { <circle cx="@source.X" cy="@source.Z" r="@source.Radius" fill="#000" /> }</mask>
                        <rect class="map-fog" width="100" height="100" mask="url(#fog-mask)" />
                    }
                    <rect x="9" y="9" width="8" height="8" fill="#83c9ba" /><rect x="83" y="83" width="8" height="8" fill="#d17791" />
                    @foreach (var resource in state.Resources) { <circle data-resource-id="@resource.Id" cx="@resource.X" cy="@resource.Z" r="3" fill="@(resource.Remaining > 0 ? "#e9c368" : "#59676b")" /> }
                    @foreach (var post in state.Units.Where(u => u.Kind == "outpost")) { <rect x="@(post.X - 3)" y="@(post.Z - 3)" width="6" height="6" fill="@(post.Construction < 100 ? "#d4b478" : "#83c9ba")" /> }
                    @foreach (var unit in state.Units.Where(u => u.Kind != "outpost")) { <circle data-unit-id="@unit.Id" cx="@unit.X" cy="@unit.Z" r="@(selection.Contains(unit.Id) ? 2.5 : 1.6)" fill="@unit.Color" stroke="@(selection.Contains(unit.Id) ? "#ffffff" : "none")" stroke-width=".7" /> }
                </svg>
                <p class="order-feedback" role="status">@(commandFeedback ?? (buildMode ? T("Klik lokasi pos di tanah terbuka, dalam 55 langkah dari candi. Esc membatalkan.", "Click open ground within 55 units of your shrine to place an outpost. Esc cancels.") : attackMove ? T("Pilih tujuan serangan di arena atau peta.", "Choose an attack destination on the arena or map.") : T("Klik atau seret kotak untuk memilih; Shift menambah. Klik tanah atau peta untuk bergerak.", "Click or drag a box to select; Shift adds. Click ground or map to move.")))</p>
            </aside>
            <aside class="economy-panel" aria-label="@T("Ekonomi RTS", "RTS economy")">
                <span class="eyebrow">@T("JALUR PERBEKALAN", "SUPPLY ROUTES")</span>
                <p>@T("Pekerja", "Workers") <b>@OwnWorkers.Count() / @Match.MaxWorkersPerPlayer</b> · @T("Pos", "Outposts") <b>@state.Units.Count(u => u.Kind == "outpost") / 4</b></p>
                <div class="economy-actions"><button @onclick="() => Send(CommandKind.RecruitWorker)" disabled="@(state.Gold < 40 || state.Supplies < 1 || OwnWorkers.Count() >= Match.MaxWorkersPerPlayer)">@T("Latih pekerja", "Train worker") <small>40 ◈ · 1 ⚑</small></button><button @onclick="SelectWorkers" disabled="@(!OwnWorkers.Any())"><kbd>3</kbd>@T("Pilih pekerja", "Select workers")</button></div>
                <div class="resource-list">@foreach (var resource in state.Resources) { <button @onclick="() => GatherResource(resource.Id)" disabled="@(!WorkersSelected || resource.Remaining == 0)">@T("Tambang", "Mine") @resource.Id <span>@resource.Remaining ◈</span></button> }</div>
                <p class="collected-gold">@T("Emas disetor", "Gold delivered"): <b>@state.GoldCollected</b></p>
                <button class="return-cargo" @onclick="() => Issue(new GameCommand(CommandKind.ReturnCargo, UnitIds: selection.ToArray()))" disabled="@(!WorkersSelected || !OwnWorkers.Any(u => selection.Contains(u.Id) && u.Cargo > 0))">@T("Setor muatan", "Return cargo")</button>
                @if (state.Units.Any(u => u.Kind == "outpost"))
                {
                    <div class="construction-list" aria-label="@T("Pembangunan pos", "Outpost construction")">
                    @foreach (var post in state.Units.Where(u => u.Kind == "outpost").OrderBy(u => u.Queue).ThenBy(u => u.Id))
                    {
                        <div class="construction-site" data-site-id="@post.Id">
                            <span>@T("Pos", "Outpost") @post.Id · @(post.Construction == 100 ? T("Siap", "Ready") : $"{post.Construction}% · #{post.Queue}")</span>
                            <progress max="100" value="@post.Construction" aria-label="@T("Progres pembangunan", "Construction progress")"></progress>
                            @if (post.Construction < 100 && post.Owner == Client.Owner)
                            {
                                <button disabled="@(!WorkersSelected)" @onclick="() => Issue(new GameCommand(CommandKind.Construct, UnitIds: selection.ToArray(), TargetId: post.Id))">@T("Kerjakan pos", "Work on outpost") @post.Id</button>
                                @if (post.Queue > 1) { <button @onclick="() => Issue(new GameCommand(CommandKind.PrioritizeConstruction, TargetId: post.Id))">@T("Dahulukan pos", "Prioritize outpost") @post.Id</button> }
                                <button @onclick="() => Issue(new GameCommand(CommandKind.CancelConstruction, TargetId: post.Id))">@T("Batalkan pos", "Cancel outpost") @post.Id · +@post.CancelRefund ◈</button>
                            }
                        </div>
                    }
                    </div>
                }
                <small>@T("Kerja 8 detik per pos. Pekerja mengikuti antrean; Dahulukan mengubah urutannya. Tahan posisi untuk berhenti. Pembatalan mengembalikan sebagian biaya.", "8 seconds of work per outpost. Builders follow the queue; Prioritize changes its order. Hold to stop. Cancellation refunds part of the cost.")</small>
            </aside>
        }
        <div class="battle-bottom">
            @if (Client.Spectating)
            {
                <section class="hero-hud spectator"><div class="hero-seal" style="--hero-color:var(--jade)">◉</div><div><span class="eyebrow">@T("PENONTON", "SPECTATOR")</span><h3>@T("Menonton ruang", "Watching room") @Client.RoomCode</h3><small>@T("Hanya melihat. Perintah dinonaktifkan.", "View only. Orders are disabled.")</small></div></section>
            }
            else
            {
            <section class="hero-hud"><div class="hero-seal" style="--hero-color:@SelectedHero.Color"><img src="_content/BattleNusantara.UI/portraits/@(SelectedHero.Id).webp" alt="" /></div><div><span class="eyebrow">@SelectedHero.Role</span><h3>@SelectedHero.Name</h3><progress max="@(Player?.MaxHealth ?? 1)" value="@(Player?.Health ?? 0)"></progress><small class="hero-health">@(state.Respawn > 0 ? T($"Bangkit dalam {Math.Ceiling(state.Respawn)} dtk", $"Respawning in {Math.Ceiling(state.Respawn)}s") : $"{Math.Ceiling(Player?.Health ?? 0)} / {Player?.MaxHealth ?? 0} HP")</small>@if (state.Mode == GameMode.Moba) { <progress class="xp" max="100" value="@((int)(state.Experience * 100))" aria-label="@T("Pengalaman hero", "Hero experience")"></progress> }</div></section>
            <div class="abilities">
                <button class="ability" @onclick="Ultimate" disabled="@(state.UltimateCooldown > 0 || Player is null)"><kbd>Q</kbd><span>✧</span><b>@(state.UltimateCooldown > 0 ? $"{Math.Ceiling(state.UltimateCooldown)}s" : SelectedHero.Skill)</b></button>
                <button class="ability" data-ability="guard" @onclick="Guard" disabled="@(state.GuardCooldown > 0 || Player is null)"><kbd>W</kbd><span>⛨</span><b>@(state.GuardCooldown > 0 ? $"{Math.Ceiling(state.GuardCooldown)}s" : T("Tameng", "Guard"))</b></button>
                @if (state.Mode == GameMode.Moba)
                {
                    @foreach (var item in Catalog.Items)
                    {
                        var level = Match.ItemLevel(state.Items, item.Id);
                        <button class="ability item" data-item="@item.Id" @onclick="() => Issue(new GameCommand(CommandKind.BuyItem, TargetId: item.Id))" disabled="@(level >= Match.MaxItemLevel || state.Gold < Match.ItemCost(item.Id, level))"><span>@(item.Id == 0 ? "†" : item.Id == 1 ? "◍" : "»")</span><b>@T(item.Name, item.NameEn)</b><small>@(level >= Match.MaxItemLevel ? T("Maks", "Max") : $"{Match.ItemCost(item.Id, level)} ◈") · Lv @level</small></button>
                    }
                }
                @if (state.Mode == GameMode.Rts)
                {
                    <button class="ability" @onclick="() => Send(CommandKind.Recruit)" disabled="@(state.Gold < 60 || state.Supplies < 2)"><span>⚔</span><b>@T("Rekrut", "Recruit")</b><small>60 ◈</small></button>
                    <button class="ability" @onclick="ToggleBuild" aria-pressed="@(buildMode ? "true" : "false")" disabled="@(state.Gold < 100 || state.Units.Count(u => u.Kind == "outpost") >= 4)"><kbd>B</kbd><span>⌂</span><b>@T("Bangun pos", "Build outpost")</b><small>100 ◈</small></button>
                    <button class="ability" @onclick="() => Send(CommandKind.Upgrade)" disabled="@(state.Gold < 140 || state.Level >= 4)"><span>↑</span><b>@T("Upgrade", "Upgrade")</b><small>140 ◈</small></button>
                }
            </div>
            }
            <div class="base-status"><span>@T("Candi sekutu", "Allied shrine") <b>@Math.Ceiling(state.BaseHealth)</b></span><progress max="900" value="@state.BaseHealth"></progress><span>@T("Gerbang musuh", "Enemy gate") <b>@Math.Ceiling(state.EnemyBaseHealth)</b></span><progress class="enemy" max="900" value="@state.EnemyBaseHealth"></progress></div>
        </div>
        @if (state.Status != MatchStatus.Playing)
        {
            <div class="modal-backdrop"><section class="panel result" role="dialog" aria-modal="true" aria-label="Match result"><span class="eyebrow">@T("PERTEMPURAN SELESAI", "BATTLE COMPLETE")</span><h1>@(state.Status == MatchStatus.Victory ? T("Nusantara bertahan.", "Nusantara endures.") : T("Gerbang telah runtuh.", "The gate has fallen."))</h1><p>@T("Setiap pertempuran menulis sejarah baru.", "Every battle writes a new history.")</p><button class="primary" @onclick="StartLocal">@T("Main lagi", "Play again") ↗</button><button class="text-button" @onclick="Home">@T("Kembali ke beranda", "Return home")</button></section></div>
        }
    }
    else if (page == "home")
    {
        <main class="home-content"><div class="eyebrow"><i></i> @T("SEBUAH LEGENDA. DUNIA YANG BARU.", "AN ANCIENT LEGEND. A WORLD REBORN.")</div><h1>@T("Warisan abadi.", "An enduring legacy.")<br /><em>@T("Pertempuran", "A battle")</em><br />@T("tanpa batas.", "beyond time.")</h1><p>@T("Ketika masa depan bertemu legenda, siapa yang akan menjaga Nusantara? Pimpin para pahlawan melintasi gerbang waktu.", "When the future meets legend, who will protect Nusantara? Lead your heroes through the gates of time.")</p><button class="primary" @onclick='() => OpenPanel("play")'>@T("MULAI PETUALANGAN", "BEGIN YOUR ADVENTURE") <span>↗</span></button><button class="story-link" @onclick='() => page = "story"'><span>▷</span> @T("Jelajahi kisahnya", "Explore the story")</button><div class="edition">PROLOGUE <span> / </span> THE QUANTUM AWAKENING <small>PLAYABLE PROTOTYPE · v0.13</small></div></main>
        <aside class="location-label"><span>JAWA TENGAH · 2125</span><h2>Borobudur Quantum</h2><p>@T("Di sini, seluruh zaman bertemu.", "Where every era converges.")</p><div class="coordinate">7°36′28″S &nbsp; 110°12′13″E</div></aside>
        <div class="mode-strip">@foreach (var item in Enum.GetValues<GameMode>()) { <button @onclick="() => ChooseMode(item)"><span class="mode-icon">@(item == GameMode.Rts ? "⚑" : item == GameMode.Moba ? "⚔" : "◇")</span><span><strong>@ModeName(item)</strong><small>@ModeDescription(item)</small></span><span class="mode-arrow">↗</span></button> }</div>
    }
    else if (page == "heroes")
    {
        <main class="content-page"><span class="eyebrow">@T("PENJAGA LINTAS ZAMAN", "GUARDIANS ACROSS TIME")</span><h1>@T("Pilih legendamu.", "Choose your legend.")</h1><p>@T("Enam penjaga. Satu dunia yang harus diselamatkan.", "Six guardians. One world to save.")</p><div class="hero-grid">@foreach (var hero in Catalog.Heroes) { <button class="hero-card @(hero.Id == heroId ? "selected" : "")" style="--hero-color:@hero.Color" @onclick="() => heroId = hero.Id"><span class="hero-art"><img src="_content/BattleNusantara.UI/portraits/@(hero.Id).webp" alt="@hero.Name" loading="lazy" /></span><span class="eyebrow">@hero.Faction / @hero.Role</span><h2>@hero.Name</h2><p>@HeroDescription(hero)</p><span class="hero-stats">@hero.Health HP <span>·</span> @hero.Damage ATK</span><small>@hero.Skill @(hero.Id == heroId ? "✓" : "")</small></button> }</div><button class="primary" @onclick='() => OpenPanel("play")'>@T("Bertempur bersama", "Fight alongside") @SelectedHero.Name ↗</button></main>
    }
    else if (page == "story")
    {
        <main class="content-page chronicle"><span class="eyebrow">THE QUANTUM AWAKENING</span><h1>@T("Sejarah belum berakhir.", "History is not over.")</h1><div class="story-columns"><article><span class="chapter">2125 / PENEMUAN</span><h2>@T("Prasasti Sang Hyang Jagat", "The Sang Hyang Jagat inscription")</h2><p>@T("Penelitian Quantum Nusantara menemukan artefak yang menghubungkan berbagai dimensi Indonesia. Kerajaan, dunia modern, mitologi, dan legenda bertabrakan menjadi satu realitas: Perang Jagat Nusantara.", "Quantum Nusantara researchers discover an artifact linking Indonesia’s many dimensions. Kingdoms, modern cities, mythology, and legends collide in a single reality: the War of Jagat Nusantara.")</p></article><article><span class="chapter">BOROBUDUR / PERTAHANAN TERAKHIR</span><h2>Sang Kalatidha</h2><p>@T("Sang Kalatidha ingin menghapus sejarah dan budaya dari seluruh dimensi. Di Borobudur Quantum, para penjaga harus memulihkan tiga prasasti dan menutup gerbang kehancuran.", "Sang Kalatidha seeks to erase history and culture across every dimension. At Borobudur Quantum, the guardians must restore three inscriptions and close the gate of destruction.")</p></article></div><button class="primary" @onclick="() => ChooseMode(GameMode.Adventure)">@T("Masuki cerita", "Enter the story") ↗</button></main>
    }

    <footer><span>SYUBADUBIN <b>STUDIOS</b></span><small>Dibuat oleh Ariana Mischa Fadhila dari Syubadubin Studios</small><button @onclick='() => OpenPanel("credits")'>@T("Kredit", "Credits") ↗</button></footer>

    @if (panel is not null)
    {
        <div class="modal-backdrop" @onclick="ClosePanel"><section class="panel @(panel == "credits" ? "credits-panel" : "")" role="dialog" aria-modal="true" aria-label="@PanelTitle" @onclick:stopPropagation="true" tabindex="-1" @ref="dialog">
            <div class="panel-heading"><span class="eyebrow">@PanelTitle</span><button class="close" @onclick="ClosePanel" aria-label="@T("Tutup", "Close")">×</button></div>
            @if (panel == "play")
            {
                <h2>@T("Satu gerbang. Tiga takdir.", "One gate. Three destinies.")</h2><div class="mode-tabs">@foreach (var item in Enum.GetValues<GameMode>()) { <button class="@(mode == item ? "selected" : "")" @onclick="() => mode = item">@ModeName(item)</button> }</div><p>@ModeDescription(mode)</p>
                <label for="hero">@T("Pahlawan", "Hero")</label><select id="hero" @bind="heroId">@foreach (var hero in Catalog.Heroes) { <option value="@hero.Id">@hero.Name · @hero.Role</option> }</select>
                <div class="mission-note">@T("Klik tanah untuk bergerak. Hero menyerang musuh terdekat secara otomatis. Gunakan Q untuk ultimate; kembali ke candi untuk memulihkan HP.", "Click the ground to move. Your hero attacks nearby enemies automatically. Press Q for your ultimate; return to the shrine to heal.")</div>
                <button class="primary wide" disabled="@busy" @onclick="StartLocal">@T("MAIN SOLO", "PLAY SOLO") ↗</button>
                @if (savedGame is not null) { <button class="secondary wide" disabled="@busy" @onclick="ContinueSaved">@T("Lanjutkan simpanan Adventure", "Continue saved Adventure")</button> }
