                    else if (Client.AccountName is { } account)
                    {
                        <p class="account-summary">@T("Masuk sebagai", "Signed in as") <b>@account</b> · @(Client.Profile?.Played ?? 0) @T("pertandingan", "matches") · @(Client.Profile?.Wins ?? 0) @T("menang", "wins")</p>
                        @if (Client.Profile is { Recent.Length: > 0 } profile)
                        {
                            <ul class="recent-matches" aria-label="@T("Pertandingan terakhir", "Recent matches")">
                                @foreach (var result in profile.Recent.Take(3)) { <li><span class="@(result.Won ? "won" : "lost")">@(result.Won ? T("Menang", "Won") : T("Kalah", "Lost"))</span> @ModeName(result.Mode) · @HeroName(result.Hero) · @TimeSpan.FromSeconds(result.Seconds).ToString(@"mm\:ss")</li> }
                            </ul>
                        }
                        @if (Client.QueueClosed is { } closed) { <p class="error" role="alert">@QueueClosedText(closed)</p> }
                        <button class="secondary wide" disabled="@busy" @onclick="FindMatch">@T("Cari pertandingan", "Find a match") · @ModeName(mode)</button>
                        <button class="text-button" disabled="@busy" @onclick="SignOut">@T("Keluar dari akun", "Sign out")</button>
