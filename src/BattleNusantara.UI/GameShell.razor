                        <label for="account-name">@T("Nama akun (3–20 huruf, angka, atau _)", "Account name (3–20 letters, digits or _)")</label><input id="account-name" @bind="accountName" maxlength="20" autocomplete="username" />
                        <label for="account-password">@T("Kata sandi (minimal 8 karakter)", "Password (at least 8 characters)")</label><input id="account-password" type="password" @bind="accountPassword" maxlength="128" autocomplete="current-password" />
                        <div class="account-actions"><button class="secondary" disabled="@busy" @onclick="() => SignIn(false)">@T("Masuk", "Sign in")</button><button class="secondary" disabled="@busy" @onclick="() => SignIn(true)">@T("Daftar akun baru", "Register")</button></div>
                    }
                </details>
                <details><summary>@T("Bermain bersama · LAN co-op (hingga 10 pemain)", "Play together · LAN co-op (up to 10 players)")</summary><label for="server">@T("Alamat server", "Server address")</label><input id="server" @bind="serverUrl" placeholder="http://localhost:5080" /><label for="code">@T("Kode ruang (kosongkan untuk membuat)", "Room code (leave empty to create)")</label><input id="code" @bind="roomCode" @bind:event="oninput" maxlength="6" placeholder="A1B2C3" /><button class="secondary wide" disabled="@busy" @onclick="() => Connect(false)">@T("Buat / gabung ruang", "Create / join room")</button><button class="text-button" disabled="@(busy || string.IsNullOrWhiteSpace(roomCode))" @onclick="() => Connect(true)">@T("Tonton ruang (perlu kode)", "Watch room (code required)")</button></details>
            }
            else if (panel == "options")
            {
                <h2>@T("Atur perjalananmu.", "Make it your journey.")</h2><label for="language">@T("Bahasa", "Language")</label><select id="language" @bind="settings.Language" @bind:after="SaveSettings"><option value="id">Bahasa Indonesia</option><option value="en">English</option></select><label for="quality">@T("Kualitas grafis", "Graphics quality")</label><select id="quality" @bind="settings.Quality" @bind:after="SaveSettings"><option value="high">@T("Tinggi", "High")</option><option value="low">@T("Hemat daya", "Power saving")</option></select><label class="check"><input type="checkbox" @bind="settings.ReducedMotion" @bind:after="SaveSettings" /> @T("Kurangi animasi", "Reduce motion")</label><label class="check"><input type="checkbox" id="cinematics" @bind="settings.Cinematics" @bind:after="SaveSettings" /> @T("Sinematik pembuka", "Opening cinematic")</label><label class="check"><input type="checkbox" id="voices" @bind="settings.Voices" @bind:after="SaveSettings" /> @T("Suara dialog", "Dialogue voices")</label><label for="volume">@T("Volume ambience", "Ambient volume") · @settings.Volume%</label><input id="volume" type="range" min="0" max="100" @bind="settings.Volume" @bind:after="SaveSettings" /><p>@T("Pengaturan disimpan pada perangkat ini.", "Settings are saved on this device.")</p>
                @if (Client.View is not null) { <button class="secondary wide" @onclick="Home">@T("Akhiri permainan dan kembali", "End game and return home")</button> }
            }
            else if (panel == "pause")
            {
                <h2>@T("Sejenak, sebelum legenda berlanjut.", "A moment before the legend continues.")</h2><p>@(Client.RoomCode is null ? T("Permainan dijeda.", "Game paused.") : T("Ruang bersama tetap berjalan.", "The shared room keeps running."))</p><button class="primary wide" @onclick="ClosePanel">@T("Lanjutkan", "Resume")</button>
                @if (Client.RoomCode is null && Client.View is { Mode: GameMode.Adventure, Status: MatchStatus.Playing }) { <button class="secondary wide" @onclick="SaveGame">@T("Simpan permainan", "Save game")</button> }
                @if (saveNotice is not null) { <p class="save-notice" role="status">@saveNotice</p> }
                <button class="text-button" @onclick="Home">@T("Akhiri permainan", "End game")</button>
            }
            else if (panel == "credits")
            {
                <h2>@T("Di balik legenda.", "Behind the legend.")</h2><div class="credits-window" tabindex="0"><div class="credits-roll"><span>CREATED BY</span><h2>Ariana Mischa Fadhila</h2><p>Syubadubin Studios</p><span>WORLD &amp; VISION</span><h2>Battle of Nusantara</h2><p>@T("Terinspirasi sejarah, budaya, dan mitologi Indonesia.", "Inspired by Indonesian history, culture, and mythology.")</p><span>TECHNOLOGY</span><p>.NET 10 · Blazor Hybrid · WPF<br />Three.js · ASP.NET Core · SignalR</p><span>ART PIPELINE</span><p>@T("Candi, 24 karakter, naga, dan properti asli", "Original shrine, 24 characters, naga and props") · Blender MCP<br />@T("Potret hero", "Hero portraits") · GPT Image (Rodin MCP)</p><span>VOICES</span><p>@T("Suara dialog", "Dialogue voices") · ElevenLabs</p><span>MUSIC</span><p>@T("Gamelan sintesis, digubah untuk game ini", "Synthesized gamelan, composed for this game")</p><h2>@T("Untuk Nusantara.", "For Nusantara.")</h2><p>Dibuat oleh Ariana Mischa Fadhila<br />dari Syubadubin Studios</p></div></div><small>@T("Arahkan pointer atau fokus untuk menghentikan guliran.", "Hover or focus to pause scrolling.")</small>
            }
            @if (error is not null) { <p class="error" role="alert">@error</p> }
        </section></div>
    }
    @if (Client.Reconnecting) { <div class="reconnect-banner" role="status">@T("Koneksi terputus. Menyambung ulang…", "Connection lost. Reconnecting…")</div> }
    @if (Client.NetworkError is not null) { <div class="error-banner" role="alert">@Client.NetworkError <button @onclick="Home">@T("Beranda", "Home")</button></div> }
    @if (renderError is not null) { <div class="error-banner" role="alert">@renderError</div> }
</div>

@code {
    private ElementReference world, dialog;
    private IJSObjectReference? renderer;
    private DotNetObjectReference<GameShell>? reference;
    private string page = "home", heroId = "gajah-mada", serverUrl = "http://localhost:5080", roomCode = "";
    private string? panel, error, renderError, savedGame, saveNotice;
    private string accountName = "", accountPassword = "";
    private bool accountOpen; // Keeps the section open after signing out or a failed attempt.
    private string HeroName(string id) => Catalog.Heroes.FirstOrDefault(h => h.Id == id)?.Name ?? id;
    private string QueueClosedText(string reason) => reason switch
    {
        "expired" => T("Tidak ada pemain lain dalam dua menit. Coba lagi.", "No other player appeared within two minutes. Try again."),
        "replaced" => T("Akun ini mulai mencari dari perangkat lain.", "This account started searching from another device."),
        _ => T("Pertandingan tidak dapat dibentuk. Coba lagi.", "The match could not be formed. Try again.")
    };
    private async Task StoreSession()
    {
        if (renderer is null) return;
        var session = Client.Session;
        await renderer.InvokeVoidAsync("saveSession", session?.Server, session?.Token);
    }
    private async Task SignIn(bool register)
    {
        busy = true; error = null; accountOpen = true;
        try
        {
            var failure = await Client.SignIn(serverUrl, accountName.Trim(), accountPassword, register);
            accountPassword = "";
            error = failure switch
            {
                null => null,
                "name" => T("Nama akun harus 3–20 huruf, angka, atau garis bawah.", "The account name must be 3–20 letters, digits or underscores."),
                "password" => T("Kata sandi harus 8–128 karakter.", "The password must be 8–128 characters."),
                "taken" => T("Nama akun sudah dipakai.", "That account name is taken."),
                "credentials" => T("Nama akun atau kata sandi salah.", "Wrong account name or password."),
                "limit" => T("Terlalu banyak percobaan. Tunggu satu menit.", "Too many attempts. Wait a minute."),
                _ => T("Server akun tidak dapat dihubungi.", "The account server could not be reached.")
            };
            if (failure is null) await StoreSession();
        }
        catch (ArgumentException) { error = T("Alamat server tidak valid.", "The server address is not valid."); }
        finally { busy = false; }
    }
    private async Task SignOut() { busy = true; accountOpen = true; try { await Client.SignOut(); await StoreSession(); } finally { busy = false; } }
    private async Task FindMatch()
    {
        busy = true; error = null;
        try { ResetOrders(); await Client.FindMatch(mode, heroId); }
        catch (Exception ex) when (ex is not OperationCanceledException) { Console.Error.WriteLine(ex); error = T("Matchmaking tidak tersedia. Masuk ulang atau periksa server.", "Matchmaking is unavailable. Sign in again or check the server."); }
        finally { busy = false; }
    }
    private async Task CancelQueue() { busy = true; try { await Client.CancelQueue(); } finally { busy = false; } }
    private DialogueLine? Line
    {
        get
        {
            var value = Client.View?.Dialogue;
            if (string.IsNullOrEmpty(value)) return null;
            var split = value.LastIndexOf(':');
            return split > 0 && int.TryParse(value.AsSpan(split + 1), out var index) && Story.Dialogues.TryGetValue(value[..split], out var lines) && index >= 0 && index < lines.Length ? lines[index] : null;
        }
    }
    private GameMode mode = GameMode.Rts;
    private GameSettings settings = new();
    private bool busy, disposed, focusDialog;
    private bool attackMove, buildMode;
    private readonly HashSet<int> selection = new();
    private readonly TacticalGroups groups = new();
    private string? commandFeedback;
    private IEnumerable<UnitView> OwnSoldiers => Client.View?.Units.Where(u => u.Owner == Client.Owner && u.Kind == "soldier") ?? [];
    private IEnumerable<UnitView> OwnWorkers => Client.View?.Units.Where(u => u.Owner == Client.Owner && u.Kind == "worker") ?? [];
    private bool WorkersSelected => selection.Count > 0 && selection.All(id => OwnWorkers.Any(w => w.Id == id));
    private string UnitLabel(string kind) => kind switch { "worker" => T("Pekerja", "Worker"), "soldier" => T("Prajurit", "Soldier"), _ => "Hero" };
    private string OrderLabel
    {
        get
        {
            var orders = Client.View?.Units.Where(u => selection.Contains(u.Id)).Select(u => u.Order).Distinct().ToArray() ?? [];
            if (orders.Length != 1) return T("Campuran", "Mixed");
            return orders[0] switch { UnitOrder.Construct => T("Membangun", "Constructing"), UnitOrder.Gather => T("Mengumpulkan", "Gathering"), UnitOrder.Move => T("Bergerak", "Moving"), UnitOrder.AttackMove => T("Serang-bergerak", "Attack-moving"), UnitOrder.Hold => T("Tahan posisi", "Holding"), _ => T("Otomatis", "Automatic") };
        }
    }
    private int refreshPending;
    private HeroDefinition SelectedHero => Catalog.Hero(heroId);
    private UnitView? Player => Client.View?.Units.FirstOrDefault(u => u.Kind == "hero" && u.Owner == Client.Owner);
    private NpcAnswer? npcAnswer;
    private bool npcBusy;
    private string npcQuestion = "", npcShown = "";
    // An NPC can be questioned once it has been met and the player's hero stands beside it.
    private NpcDefinition? NearbyNpc
    {
        get
        {
            if (Client.View is not { Mode: GameMode.Adventure, Status: MatchStatus.Playing } view || Client.Spectating) return null;
            var hero = view.Units.FirstOrDefault(u => u.Kind == "hero" && u.Owner == Client.Owner);
            if (hero is null) return null;
            foreach (var unit in view.Units)
            {
                if (unit.Kind != "npc" || Math.Pow(hero.X - unit.X, 2) + Math.Pow(hero.Z - unit.Z, 2) > 100) continue;
                var met = unit.Model == Story.CaptainNpc
                    ? view.Quests?.LastOrDefault()?.Id is { } side && side != Story.Captain
                    : view.Quests?.FirstOrDefault(q => q.Id == Story.Keeper)?.State == QuestState.Done;
                if (met && Story.Npc(unit.Model) is { } npc)
                {
                    // A fresh conversation for each NPC.
                    if (npcShown != npc.Id) { npcShown = npc.Id; npcAnswer = null; }
                    return npc;
                }
            }
            return null;
        }
    }
    private async Task AskNpc(string topic)
    {
        if (npcBusy) return;
        npcBusy = true; StateHasChanged();
        try { npcAnswer = await Client.AskNpc(serverUrl, topic, settings.Language); }
        finally { npcBusy = false; StateHasChanged(); }
    }
    private async Task TalkToNpc()
    {
        if (npcBusy || NearbyNpc is not { } npc || string.IsNullOrWhiteSpace(npcQuestion)) return;
        npcBusy = true; StateHasChanged();
        try { npcAnswer = await Client.TalkToNpc(serverUrl, npc.Id, npcQuestion, settings.Language) ?? npcAnswer; npcQuestion = ""; }
        finally { npcBusy = false; StateHasChanged(); }
    }
    private Sky CurrentSky => Atmosphere.At(Client.View?.Tick ?? 0);
    private string SkyLabel => (CurrentSky.Weather switch { "mist" => T("🌫 Kabut", "🌫 Mist"), "rain" => T("🌧 Hujan", "🌧 Rain"), "storm" => T("⛈ Badai", "⛈ Storm"), _ => T("☀ Cerah", "☀ Clear") })
        + " · " + (CurrentSky.Phase switch { "night" => T("Malam", "Night"), "dusk" => T("Senja", "Dusk"), "dawn" => T("Fajar", "Dawn"), _ => T("Siang", "Day") });
    private string TimeLabel => TimeSpan.FromSeconds((Client.View?.Tick ?? 0) * .1).ToString(@"mm\:ss");
    private string PanelTitle => panel switch { "play" => T("PRASASTI MENUNGGUMU", "THE INSCRIPTION AWAITS"), "options" => T("PENGATURAN", "SETTINGS"), "credits" => "SYUBADUBIN STUDIOS", _ => T("JEDA", "PAUSE") };
    private string T(string id, string en) => settings.Language == "en" ? en : id;
    private string ModeName(GameMode value) => value switch { GameMode.Rts => "RTS Skirmish", GameMode.Moba => "MOBA Arena", _ => "Adventure" };
    private string ModeDescription(GameMode value) => value switch { GameMode.Rts => T("Bangun. Pimpin. Taklukkan.", "Build. Command. Conquer."), GameMode.Moba => T("Lima lawan lima. Tiga jalur.", "Five against five. Three lanes."), _ => T("Pulihkan prasasti yang hilang.", "Recover the lost inscriptions.") };
    private string HeroDescription(HeroDefinition hero) => settings.Language == "id" ? hero.Description : hero.Id switch { "gajah-mada" => "An oath to unite the archipelago. Lead the vanguard and break enemy lines.", "cut-nyak-dien" => "Courage from Aceh. Strike swiftly from the front line.", "nyi-roro-kidul" => "Guardian of the southern sea. Sweep away the forces of Kalatidha.", "bledhek" => "A lightning fighter from the slopes of Merapi. His strike leaps from foe to foe, then he darts away like a flash.", "rara-angkasa" => "A sky guardian of giant strength. She flies onto the enemy and strikes the ground with a shockwave.", _ => "A guardian from 2125, armed with quantum energy." };

    protected override void OnInitialized()
    {
        Client.Changed += OnChanged;
        if (!new Uri(Navigation.BaseUri).Host.StartsWith("0.0.0.", StringComparison.Ordinal)) serverUrl = Navigation.BaseUri.TrimEnd('/');
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                renderer = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/BattleNusantara.UI/world.js");
                settings = await renderer.InvokeAsync<GameSettings>("loadSettings");
                reference = DotNetObjectReference.Create(this);
                savedGame = await renderer.InvokeAsync<string?>("loadGame");
                if (await renderer.InvokeAsync<StoredSession?>("loadSession") is { Server: { } storedServer, Token: { } storedToken } && !await Client.Resume(storedServer, storedToken))
                    await renderer.InvokeVoidAsync("saveSession", null, null);
                await renderer.InvokeVoidAsync("mount", world, reference, settings);
                await Refresh();
                StateHasChanged();
            }
            catch (JSException) { renderError = T("Arena 3D gagal dimuat. Aktifkan WebGL dan muat ulang aplikasi.", "The 3D arena could not load. Enable WebGL and reload the application."); StateHasChanged(); }
        }
        if (focusDialog) { focusDialog = false; await dialog.FocusAsync(); }
    }
    private void OnChanged() => _ = Refresh();
    private async Task Refresh()
    {
        if (disposed || Interlocked.Exchange(ref refreshPending, 1) != 0) return;
        try
        {
            await InvokeAsync(async () =>
            {
                if (disposed) return;
                if (panel == "play" && Client.View is not null) ClosePanel(); // Matchmaking seated us while the panel was open.
                selection.IntersectWith(Client.View?.Units.Where(u => u.Owner == Client.Owner).Select(u => u.Id) ?? []);
                groups.Prune(Client.View, Client.Owner);
                if (selection.Count == 0 && Player is { } hero) selection.Add(hero.Id);
                if (renderer is not null) await renderer.InvokeVoidAsync("update", Client.View, Client.Owner, selection.ToArray(), attackMove, buildMode, Client.View is null ? null : CurrentSky);
                StateHasChanged();
            });
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
        finally { Interlocked.Exchange(ref refreshPending, 0); }
    }
    private void OpenPanel(string name) { if (name == "play" && Client.AccountName is not null) _ = Client.RefreshProfile().ContinueWith(_ => InvokeAsync(StateHasChanged), TaskScheduler.Default); panel = name; error = null; saveNotice = null; focusDialog = true; if (Client.RoomCode is null) Client.Paused = true; }
    private void ClosePanel() { panel = null; error = null; Client.Paused = false; }
    private void ChooseMode(GameMode selected) { mode = selected; OpenPanel("play"); }
    private void ResetOrders() { selection.Clear(); groups.Clear(); attackMove = buildMode = false; commandFeedback = null; }
    private async Task StartLocal() { ResetOrders(); await Client.StartLocal(mode, heroId); ClosePanel(); await Refresh(); }
    private async Task Home() { await Client.Leave(); ResetOrders(); ClosePanel(); page = "home"; await Refresh(); }
    private async Task SaveGame()
    {
        error = null; saveNotice = null;
        var json = await Client.Save();
        if (json is not null && renderer is not null && await renderer.InvokeAsync<bool>("saveGame", json))
        { savedGame = json; saveNotice = T("Permainan tersimpan di perangkat ini.", "Game saved on this device."); }
        else error = T("Permainan tidak dapat disimpan.", "The game could not be saved.");
    }
    private async Task ContinueSaved()
    {
        if (savedGame is null) return;
        string? hero = null;
        try { using var document = System.Text.Json.JsonDocument.Parse(savedGame); hero = document.RootElement.GetProperty("Hero").GetString(); }
        catch (Exception ex) when (ex is System.Text.Json.JsonException or KeyNotFoundException or InvalidOperationException) { }
        ResetOrders();
        if (hero is null || !await Client.StartSaved(savedGame))
        {
            savedGame = null; error = T("Simpanan rusak dan telah dihapus.", "The save was damaged and has been removed.");
            if (renderer is not null) await renderer.InvokeVoidAsync("clearGame");
            return;
        }
        heroId = hero; mode = GameMode.Adventure; ClosePanel(); await Refresh();
    }
    private async Task Connect(bool watch)
    {
        busy = true; error = null;
        try { ResetOrders(); await Client.Connect(serverUrl, roomCode, mode, heroId, watch); ClosePanel(); await Refresh(); }
        catch (Exception ex) when (ex is not OperationCanceledException) { Console.Error.WriteLine(ex); error = watch ? T("Tidak dapat menonton. Periksa alamat server dan kode ruang.", "Could not watch. Check the server address and room code.") : T("Tidak dapat bergabung. Periksa alamat server, kode ruang, dan kapasitas ruang.", "Could not join. Check the server address, room code, and room capacity."); }
        finally { busy = false; }
    }
    private async Task Send(CommandKind kind)
    {
        await Issue(new GameCommand(kind));
    }
    private Task Ultimate() => Send(CommandKind.Ultimate);
    private Task Guard() => Send(CommandKind.Guard);
    private async Task Issue(GameCommand command)
    {
        try
        {
            var accepted = await Client.Command(command);
            commandFeedback = accepted ? T("Perintah diterima.", "Order accepted.") : T("Perintah ditolak. Pilih unit sendiri dan tanah yang terbuka; periksa biaya atau cooldown.", "Order rejected. Select your units and open ground; check cost or cooldown.");
            if (accepted) attackMove = buildMode = false;
        }
        catch (Exception ex) when (ex is InvalidOperationException or Microsoft.AspNetCore.SignalR.HubException or OperationCanceledException)
        { commandFeedback = T("Perintah gagal. Periksa koneksi server.", "Command failed. Check the server connection."); }
        await Refresh();
    }
    [JSInvokable] public async Task MoveTo(double x, double z)
    {
        if (panel is not null) return;
        if (buildMode) { await Issue(new GameCommand(CommandKind.Build, x, z)); return; }
        await Issue(new GameCommand(attackMove ? CommandKind.AttackMove : CommandKind.Move, x, z,
            Client.View?.Mode == GameMode.Rts ? selection.ToArray() : null));
    }
    [JSInvokable] public async Task SelectUnit(int id, bool additive)
    {
        if (panel is not null || Client.View?.Mode != GameMode.Rts || !Client.View.Units.Any(u => u.Id == id && u.Owner == Client.Owner && (u.Kind is "hero" or "soldier" or "worker"))) return;
        buildMode = false;
        if (!additive) selection.Clear();
        if (!selection.Remove(id) && selection.Count < Match.MaxSelection) selection.Add(id);
        commandFeedback = null;
        await Refresh();
    }
    private async Task SelectHero() { selection.Clear(); if (Player is { } hero) selection.Add(hero.Id); attackMove = buildMode = false; commandFeedback = null; await Refresh(); }
    [JSInvokable] public async Task SelectUnits(int[] ids, bool additive)
    {
        if (panel is not null || Client.View?.Mode != GameMode.Rts || ids.Length > Match.MaxUnits) return;
        var owned = TacticalGroups.Filter(ids, Client.View, Client.Owner);
        if (owned.Length == 0) commandFeedback = T("Tidak ada unit milikmu dalam kotak.", "No owned units inside the box.");
        else
        {
            var selected = TacticalGroups.Filter(additive ? selection.Concat(owned) : owned, Client.View, Client.Owner);
            selection.Clear(); selection.UnionWith(selected);
            attackMove = buildMode = false; commandFeedback = null;
        }
        await Refresh();
    }
    [JSInvokable] public async Task ControlGroup(int slot, bool save)
    {
        if (panel is not null || Client.View?.Mode != GameMode.Rts || slot is < 4 or > 6) return;
        if (save)
            commandFeedback = groups.Save(slot, selection, Client.View, Client.Owner)
                ? T($"Grup {slot} disimpan.", $"Group {slot} saved.") : T("Pilih unit milikmu terlebih dahulu.", "Select your units first.");
        else
        {
            var recalled = groups.Recall(slot, Client.View, Client.Owner);
            if (recalled.Length == 0) commandFeedback = T($"Grup {slot} kosong.", $"Group {slot} is empty.");
            else { selection.Clear(); selection.UnionWith(recalled); attackMove = buildMode = false; commandFeedback = null; }
        }
        await Refresh();
    }
    private async Task SelectArmy()
    {
        var army = OwnSoldiers.Take(Match.MaxSelection).Select(u => u.Id).ToArray();
        if (army.Length == 0) return;
        selection.Clear(); selection.UnionWith(army); attackMove = buildMode = false; commandFeedback = null; await Refresh();
    }
    private async Task SelectWorkers()
    {
        var workers = OwnWorkers.Select(u => u.Id).ToArray();
        if (workers.Length == 0) return;
        selection.Clear(); selection.UnionWith(workers); attackMove = buildMode = false; commandFeedback = null; await Refresh();
    }
    [JSInvokable] public Task GatherResource(int id) => panel is null ? Issue(new GameCommand(CommandKind.Gather, UnitIds: selection.ToArray(), TargetId: id)) : Task.CompletedTask;
    private async Task ToggleBuild() { buildMode = !buildMode; attackMove = false; commandFeedback = null; await Refresh(); }
    private async Task ToggleAttackMove() { attackMove = !attackMove; buildMode = false; commandFeedback = null; await Refresh(); }
    private Task HoldPosition() => Issue(new GameCommand(CommandKind.HoldPosition, UnitIds: selection.ToArray()));
    [JSInvokable] public async Task Key(string key)
    {
        if (key == "Escape") { if (panel is not null) ClosePanel(); else if (attackMove || buildMode) { attackMove = buildMode = false; commandFeedback = null; await Refresh(); } else if (Client.View is not null) OpenPanel("pause"); }
        else if (panel is null && key == "q") await Ultimate();
        else if (panel is null && key == "w") await Guard();
        else if (panel is null && Client.View?.Mode == GameMode.Rts)
        {
            if (key == "1") await SelectHero();
            else if (key == "2") await SelectArmy();
            else if (key == "a") await ToggleAttackMove();
            else if (key == "h") await HoldPosition();
            else if (key == "3") await SelectWorkers();
            else if (key == "b") await ToggleBuild();
        }
        await InvokeAsync(StateHasChanged);
    }
    private async Task SaveSettings() { if (renderer is not null) await renderer.InvokeVoidAsync("settings", settings); }
    public async ValueTask DisposeAsync()
    {
        disposed = true; Client.Changed -= OnChanged;
        if (renderer is not null) { try { await renderer.InvokeVoidAsync("dispose"); await renderer.DisposeAsync(); } catch (JSDisconnectedException) { } }
        reference?.Dispose();
    }
    public sealed record StoredSession(string? Server, string? Token);
    public sealed class GameSettings
    {
        public string Language { get; set; } = "id";
        public string Quality { get; set; } = "high";
        public bool ReducedMotion { get; set; }
        public int Volume { get; set; } = 20;
        public bool Cinematics { get; set; } = true;
        public bool Voices { get; set; } = true;
    }
}
