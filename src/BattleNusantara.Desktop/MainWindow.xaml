<Window x:Class="BattleNusantara.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:ui="clr-namespace:BattleNusantara.UI;assembly=BattleNusantara.UI"
        Title="Battle of Nusantara | Syubadubin Studios" Width="1440" Height="900" MinWidth="900" MinHeight="650" Background="#101F28" WindowStartupLocation="CenterScreen">
    <blazor:BlazorWebView x:Name="GameView" HostPage="wwwroot/index.html">
        <blazor:BlazorWebView.RootComponents><blazor:RootComponent Selector="#app" ComponentType="{x:Type ui:GameShell}" /></blazor:BlazorWebView.RootComponents>
    </blazor:BlazorWebView>
</Window>
