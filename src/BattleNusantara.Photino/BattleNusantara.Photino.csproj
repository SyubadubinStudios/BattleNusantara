<Project Sdk="Microsoft.NET.Sdk.Razor">
  <!-- The macOS and Linux desktop host: the same GameShell in a native WebView (WebKit on macOS, WebKitGTK on Linux) through Photino. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>BattleNusantara</AssemblyName>
    <RootNamespace>BattleNusantara.Photino</RootNamespace>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../BattleNusantara.UI/BattleNusantara.UI.csproj" />
    <PackageReference Include="Photino.Blazor" Version="4.0.13" />
    <Content Update="wwwroot/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
